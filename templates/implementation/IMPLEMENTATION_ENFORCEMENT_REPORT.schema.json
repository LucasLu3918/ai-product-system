{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aips.local/schemas/implementation-enforcement-report-v1.json",
  "title": "AIPS Implementation Enforcement Evidence v1",
  "oneOf": [
    { "$ref": "#/$defs/assessment" },
    { "$ref": "#/$defs/command" }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "file": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "assessment": {
      "type": "object",
      "required": ["schema_version", "kind", "mode", "status", "profile", "candidate", "checks", "authority", "fingerprint"],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "implementation_enforcement" },
        "mode": { "enum": ["report", "enforce"] },
        "status": { "enum": ["PASS", "FAIL", "BLOCKED", "UNVERIFIED", "SKIPPED"] },
        "profile": { "$ref": "#/$defs/file" },
        "language_profile": { "anyOf": [{ "$ref": "#/$defs/file" }, { "type": "null" }] },
        "candidate": {
          "type": "object",
          "required": ["base_sha", "head_sha", "changed_files", "applicable_files"],
          "properties": {
            "base_sha": { "$ref": "#/$defs/revision" },
            "head_sha": { "$ref": "#/$defs/revision" },
            "changed_files": { "type": "array", "items": { "type": "string" } },
            "applicable_files": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "status", "reason"],
            "properties": {
              "id": { "type": "string" },
              "status": { "enum": ["PASS", "FAIL", "BLOCKED", "UNVERIFIED"] },
              "reason": { "type": "string" },
              "path": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "authority": {
          "type": "object",
          "required": ["merge_authorized", "human_authority_preserved"],
          "properties": {
            "merge_authorized": { "const": false },
            "human_authority_preserved": { "const": true }
          },
          "additionalProperties": false
        },
        "fingerprint": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "required": ["schema_version", "kind", "status", "profile_sha256", "repository_revision", "command_id", "argv_sha256", "source_sha256", "runs", "raw_output_persisted"],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "implementation_command" },
        "status": { "enum": ["PASS", "FAIL", "UNVERIFIED"] },
        "profile_sha256": { "$ref": "#/$defs/digest" },
        "repository_revision": { "$ref": "#/$defs/revision" },
        "command_id": { "type": "string", "minLength": 1 },
        "argv_sha256": { "$ref": "#/$defs/digest" },
        "source_sha256": { "$ref": "#/$defs/digest" },
        "runs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": ["index", "exit_code", "timed_out", "output_sha256", "output_bytes", "output_truncated"],
            "properties": {
              "index": { "type": "integer", "minimum": 1 },
              "exit_code": { "type": ["integer", "null"] },
              "timed_out": { "type": "boolean" },
              "output_sha256": { "$ref": "#/$defs/digest" },
              "output_bytes": { "type": "integer", "minimum": 0, "maximum": 1048576 },
              "output_truncated": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "raw_output_persisted": { "const": false }
      },
      "additionalProperties": false
    }
  }
}
