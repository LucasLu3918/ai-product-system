{
  "hooks": {
    "BeforeAgent": [
      {
        "hooks": [
          {
            "name": "aips-turn-context",
            "type": "command",
            "command": "\"${extensionPath}${/}hooks${/}aips-turn-context.sh\"",
            "timeout": 5000,
            "description": "Inject compact AIPS Turn Context before planning"
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "matcher": "run_shell_command",
        "hooks": [
          {
            "name": "aips-governance-guard",
            "type": "command",
            "command": "bash \"${extensionPath}${/}hooks${/}aips-governance-guard.sh\"",
            "timeout": 5000,
            "description": "Block protected Git publication operations without a current AIPS approval binding"
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "read_file|write_file|replace",
        "hooks": [
          {
            "name": "aips-observable-event-capture",
            "type": "command",
            "command": "\"${extensionPath}${/}hooks${/}aips-observable-event-capture.sh\"",
            "timeout": 2000,
            "description": "Opt-in metadata-only AIPS observable-event capture after supported file tools"
          }
        ]
      }
    ]
  }
}
